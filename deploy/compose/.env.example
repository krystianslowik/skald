# Copy to .env and fill in. Never commit the real .env.

# --- Game ---------------------------------------------------------------
SERVER_NAME=My Valheim
# Exact (case-sensitive) world folder name under /config/worlds_local.
WORLD_NAME=Midgard
# What players type after the join code. At least 5 characters.
SERVER_PASS=change-me
# Vanilla world modifiers, e.g. -preset casual -modifier raids less
SERVER_ARGS=
# These three are only the starting point: once you save server settings on
# the dashboard, the values there win on every restart.
TZ=UTC

# --- Secrets between the containers --------------------------------------
# openssl rand -hex 32
AGENT_TOKEN=
# openssl rand -hex 24
SUPERVISOR_HTTP_PASS=
# openssl rand -hex 32
SESSION_SECRET=

# --- Dashboard password ----------------------------------------------------
# An argon2id hash, never the password itself. Generate it with:
#   printf '%s' 'your panel password' | docker run --rm -i ghcr.io/krystianslowik/skald-web hash-password
# or, with Bun installed:
#   bun -e 'console.log(await Bun.password.hash(process.argv[1], "argon2id"))' 'your panel password'
# Keep the SINGLE quotes: the hash contains $ signs that Compose would expand.
PANEL_PASSWORD_HASH='$argon2id$replace-me'
# Optional admin password (same command). Set, the panel password only views
# and admin actions, restarts and settings need this one; unset, everyone
# signed in is an admin.
ADMIN_PASSWORD_HASH=

# --- Dashboard options ------------------------------------------------------
# en or pl; every viewer can still switch in the header.
SKALD_LOCALE=en
SKALD_PORT=8080
# Set to true once Skald is served over HTTPS.
COOKIE_SECURE=false
# Behind a reverse proxy: the header carrying the client IP, e.g. X-Forwarded-For.
TRUSTED_IP_HEADER=
# Only when the proxy rewrites the Host header (plain nginx without
# `proxy_set_header Host $host;`): the panel's address, e.g. https://panel.example.
PUBLIC_ORIGIN=
# Optional Prometheus for the CPU / memory / network charts.
PROM_URL=
# Only if you give the valheim service a mem_limit: the same limit (6g there is 6Gi here),
# so the memory bar measures against it. Empty: against the 6-hour peak.
GAME_MEMORY_LIMIT=
# Optional Discord notifications: a channel webhook URL (a secret). Empty: set
# it in the admin sheet instead. Set here, it wins and the panel is read-only.
DISCORD_WEBHOOK_URL=
# Which ones, comma-separated; empty sends all of them:
# join, leave, death, raid, server, join_code, version, failure
DISCORD_NOTIFY=
# Phone notifications: whom the browsers' push services can contact about this
# panel, mailto: or https://. Empty: your https PUBLIC_ORIGIN.
PUSH_CONTACT=
# Pin a release instead of latest, e.g. 2026.10.31. To update, change it, then
# docker compose pull && docker compose up -d (README, "Updating").
SKALD_VERSION=latest

# --- Item icons (opt-in) -----------------------------------------------------
# icons: build an item icon sheet from your own installed game files for the
# chests, graves and village stores. Skald ships no game artwork; the sheet
# stays on your volume and is shown only behind the panel password.
COMPOSE_PROFILES=

# --- Admin bridge (opt-in) ---------------------------------------------------
# Live admin commands (broadcast, items, teleport, time, raids, kick/ban...)
# through a server-side BepInEx plugin. Read docs/configuration.md "Admin bridge" first: it
# runs the server modded. To enable: add bridge to COMPOSE_PROFILES (comma-
# separated, e.g. icons,bridge), set BEPINEX=true and a BRIDGE_TOKEN.
BEPINEX=false
# openssl rand -hex 24 (at least 16 characters)
BRIDGE_TOKEN=
# Kill switch: off loads the plugin but serves nothing.
SKALD_BRIDGE=on
