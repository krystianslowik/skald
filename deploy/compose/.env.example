# Copy to .env and fill in. Never commit the real .env.

# --- Game ---------------------------------------------------------------
SERVER_NAME=My Valheim
# Exact (case-sensitive) world folder name under /config/worlds_local.
WORLD_NAME=Midgard
# What players type after the join code. At least 5 characters.
SERVER_PASS=change-me
# Vanilla world modifiers, e.g. -modifier raids less -preset casual
SERVER_ARGS=
TZ=UTC

# --- Secrets between the containers --------------------------------------
# openssl rand -hex 32
AGENT_TOKEN=
# openssl rand -hex 24
SUPERVISOR_HTTP_PASS=
# openssl rand -hex 32
SESSION_SECRET=

# --- Dashboard password ----------------------------------------------------
# An argon2id hash, never the password itself. Generate it with:
#   printf '%s' 'your panel password' | docker run --rm -i ghcr.io/krystianslowik/skald-web hash-password
# or, with Bun installed:
#   bun -e 'console.log(await Bun.password.hash(process.argv[1], "argon2id"))' 'your panel password'
# Keep the SINGLE quotes: the hash contains $ signs that Compose would expand.
PANEL_PASSWORD_HASH='$argon2id$replace-me'

# --- Dashboard options ------------------------------------------------------
# en or pl; every viewer can still switch in the header.
SKALD_LOCALE=en
SKALD_PORT=8080
# Set to true once Skald is served over HTTPS.
COOKIE_SECURE=false
# Behind a reverse proxy: the header carrying the client IP, e.g. X-Forwarded-For.
TRUSTED_IP_HEADER=
# Optional Prometheus for the CPU / memory / network charts.
PROM_URL=
# Pin a release instead of latest, e.g. 0.1.0
SKALD_VERSION=latest
