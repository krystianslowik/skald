<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the game-independent parts of the plugin (no game DLLs needed). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../plugin/MapData.cs" Link="MapData.cs" />
    <Compile Include="../plugin/TerrainTile.cs" Link="TerrainTile.cs" />
    <Compile Include="../plugin/FillPlan.cs" Link="FillPlan.cs" />
    <Compile Include="../plugin/ChestPlan.cs" Link="ChestPlan.cs" />
    <Compile Include="../plugin/RefuelPlan.cs" Link="RefuelPlan.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
